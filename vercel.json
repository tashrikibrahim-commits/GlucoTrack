{
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
        { "src": "/(.*\\.php)", "dest": "/api/index.php" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
