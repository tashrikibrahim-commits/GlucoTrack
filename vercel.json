{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
        { "src": "/(.*\\.php)", "dest": "/api/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "PHP_INI_SCAN_DIR": "/usr/local/etc/php/conf.d/:/var/task/api"
    }
}
